{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "sourceId", "source", "capture", "blocks", "media"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "sourceId": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "required": ["url", "type", "platform", "title", "capturedAt"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "resolvedUrl": { "type": "string", "format": "uri" },
        "type": { "enum": ["article", "video"] },
        "platform": { "enum": ["web", "youtube"] },
        "title": { "type": "string", "minLength": 1 },
        "author": { "type": "string" },
        "publishedAt": { "type": "string", "format": "date" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "durationSeconds": { "type": "number", "minimum": 0 },
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "startMs", "endMs"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "startMs": { "type": "integer", "minimum": 0 },
              "endMs": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "capture": {
      "type": "object",
      "required": ["status", "method", "missing"],
      "properties": {
        "status": { "enum": ["complete", "partial"] },
        "method": { "enum": ["trafilatura", "yt-dlp", "whisper.cpp"] },
        "missing": { "type": "array", "items": { "type": "string" } },
        "captionLanguage": { "type": "string", "minLength": 1 },
        "automaticCaptions": { "type": "boolean" },
        "transcriptLanguage": { "type": "string", "minLength": 1 },
        "transcriptModel": { "type": "string", "minLength": 1 },
        "transcriptModelSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "captionsFallback": { "type": "boolean" },
        "audio": {
          "type": "object",
          "required": ["file", "sha256", "size", "startMs", "endMs", "parts"],
          "properties": {
            "file": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "size": { "type": "integer", "minimum": 1 },
            "startMs": { "type": "integer", "minimum": 0 },
            "endMs": { "type": "integer", "minimum": 1 },
            "parts": { "type": "integer", "minimum": 1 },
            "partsWithoutRecognizedSpeech": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^b-[0-9]+$" },
          "kind": { "enum": ["paragraph", "transcript_segment"] },
          "text": { "type": "string", "minLength": 1 },
          "startMs": { "type": "integer", "minimum": 0 },
          "endMs": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "transcriptParts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "path", "sha256", "size", "dependencies", "validated"],
        "properties": {
          "kind": { "const": "transcript-part" },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size": { "type": "integer", "minimum": 1 },
          "dependencies": { "type": "array", "maxItems": 0 },
          "validated": { "const": true }
        }
      }
    },
    "media": { "type": "array", "maxItems": 0 }
  },
  "if": { "properties": { "source": { "properties": { "type": { "const": "video" } } } } },
  "then": {
    "properties": {
      "source": { "properties": { "platform": { "const": "youtube" } } },
      "capture": { "properties": { "method": { "enum": ["yt-dlp", "whisper.cpp"] } } },
      "blocks": {
        "items": {
          "required": ["startMs", "endMs"],
          "properties": { "kind": { "const": "transcript_segment" } }
        }
      }
    },
    "allOf": [{
      "if": { "required": ["transcriptParts"] },
      "then": { "properties": { "blocks": { "maxItems": 0 } } }
    }],
    "if": { "properties": { "capture": { "properties": { "method": { "const": "whisper.cpp" } } } } },
    "then": {
      "properties": {
        "capture": { "required": ["transcriptLanguage", "transcriptModel"] }
      },
      "anyOf": [
        { "properties": { "blocks": { "minItems": 1 } } },
        { "required": ["transcriptParts"] }
      ]
    },
    "else": {
      "if": {
        "anyOf": [
          { "properties": { "blocks": { "minItems": 1 } } },
          { "required": ["transcriptParts"] }
        ]
      },
      "then": { "properties": { "capture": { "required": ["captionLanguage", "automaticCaptions"] } } },
      "else": { "properties": { "capture": { "properties": { "status": { "const": "partial" } } } } }
    }
  },
  "else": {
    "properties": {
      "source": { "properties": { "platform": { "const": "web" } } },
      "capture": { "properties": { "method": { "const": "trafilatura" } } },
      "blocks": {
        "minItems": 1,
        "items": { "properties": { "kind": { "const": "paragraph" } } }
      }
    }
  }
}
