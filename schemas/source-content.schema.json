{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "sourceId", "source", "capture", "blocks", "media"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "sourceId": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "required": ["url", "type", "platform", "title", "capturedAt"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "resolvedUrl": { "type": "string", "format": "uri" },
        "type": { "const": "article" },
        "platform": { "const": "web" },
        "title": { "type": "string", "minLength": 1 },
        "author": { "type": "string" },
        "publishedAt": { "type": "string", "format": "date" },
        "capturedAt": { "type": "string", "format": "date-time" }
      }
    },
    "capture": {
      "type": "object",
      "required": ["status", "method", "missing"],
      "properties": {
        "status": { "enum": ["complete", "partial"] },
        "method": { "const": "trafilatura" },
        "missing": { "type": "array", "items": { "type": "string" } }
      }
    },
    "blocks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^b-[0-9]+$" },
          "kind": { "const": "paragraph" },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "media": { "type": "array", "maxItems": 0 }
  }
}
