{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "sourceId", "title", "language", "method", "coverage", "insights"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "sourceId": { "type": "string", "minLength": 1 },
    "focusNote": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "language": { "const": "pt-BR" },
    "method": { "const": "extractive" },
    "visual": {
      "$ref": "#/$defs/visualEvidence",
      "required": ["model"],
      "properties": {
        "analysisMode": { "const": "youtube-url" }
      }
    },
    "frameInspection": {
      "$ref": "#/$defs/visualEvidence",
      "properties": {
        "analysisMode": { "const": "targeted-frames" }
      }
    },
    "coverage": {
      "type": "object",
      "required": ["status", "unresolved"],
      "properties": {
        "status": { "const": "partial" },
        "unresolved": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "insights": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "kind", "title", "explanation", "evidence", "confidence", "limitations"],
        "properties": {
          "id": { "type": "string", "pattern": "^insight-[0-9]+$" },
          "kind": { "const": "excerpt" },
          "title": { "type": "string", "minLength": 1 },
          "explanation": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["sourceBlockId", "locator"],
              "properties": {
                "sourceBlockId": { "type": "string", "pattern": "^b-[0-9]+$" },
                "locator": { "type": "string", "minLength": 1 }
              }
            }
          },
          "confidence": { "const": "supported" },
          "limitations": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "$defs": {
    "visualEvidence": {
      "type": "object",
      "required": ["artifactPath", "artifactSha256", "analysisMode", "observations"],
      "properties": {
        "artifactPath": { "type": "string", "minLength": 1 },
        "artifactSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "analysisMode": { "type": "string", "minLength": 1 },
        "model": { "$ref": "video-visual.schema.json#/$defs/model" },
        "observations": { "$ref": "video-visual.schema.json#/$defs/observations" }
      }
    }
  }
}
