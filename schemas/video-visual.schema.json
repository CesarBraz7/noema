{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "sourceId", "sourceUrl", "provider", "analysisMode", "promptVersion", "requestedModel", "metadataSha256", "durationMs", "analyzedAt", "budgetUsd", "response"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "sourceId": { "type": "string", "pattern": "^youtube-[a-f0-9]{64}$" },
    "sourceUrl": { "type": "string", "format": "uri" },
    "provider": { "const": "gemini" },
    "analysisMode": { "const": "youtube-url" },
    "promptVersion": { "type": "string", "minLength": 1 },
    "requestedModel": { "$ref": "#/$defs/model" },
    "metadataSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "durationMs": { "type": "integer", "minimum": 1 },
    "analyzedAt": { "type": "string", "format": "date-time" },
    "budgetUsd": { "const": 0 },
    "response": {
      "type": "object",
      "required": ["model", "observations", "limitations", "frameChecks"],
      "properties": {
        "model": { "$ref": "#/$defs/model" },
        "interactionId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "usage": {
          "type": "object",
          "required": ["total_input_tokens", "total_output_tokens", "total_thought_tokens", "total_tokens"],
          "properties": {
            "total_input_tokens": { "type": "integer", "minimum": 0 },
            "total_output_tokens": { "type": "integer", "minimum": 0 },
            "total_thought_tokens": { "type": "integer", "minimum": 0 },
            "total_tokens": { "type": "integer", "minimum": 0 }
          }
        },
        "observations": { "$ref": "#/$defs/observations" },
        "limitations": {
          "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 900 }
        },
        "frameChecks": {
          "type": "array", "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["atMs", "reason"],
            "properties": {
              "atMs": { "type": "integer", "minimum": 0 },
              "reason": { "type": "string", "minLength": 1, "maxLength": 900 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "model": { "type": "string", "pattern": "^gemini-[a-z0-9][a-z0-9.-]*$" },
    "observations": {
      "type": "array", "maxItems": 24, "items": {
        "type": "object",
        "required": ["id", "kind", "startMs", "endMs", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[vf]-[0-9]+$" },
          "kind": { "enum": ["code", "slide", "diagram", "table", "demo", "other"] },
          "startMs": { "type": "integer", "minimum": 0 },
          "endMs": { "type": "integer", "minimum": 1 },
          "description": { "type": "string", "minLength": 1, "maxLength": 1800 },
          "visibleText": { "type": "string", "maxLength": 1500 }
        }
      }
    }
  }
}
