{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "sourceId", "fingerprint", "pipelineVersion", "extractorVersion", "artifacts"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "sourceId": { "type": "string", "minLength": 1 },
    "fingerprint": { "$ref": "#/$defs/sha256" },
    "pipelineVersion": { "type": "string", "minLength": 1 },
    "extractorVersion": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["kind", "path", "sha256", "size", "dependencies", "validated"],
        "properties": {
          "kind": { "enum": ["source-content", "knowledge"] },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "size": { "type": "integer", "minimum": 1 },
          "dependencies": { "type": "array", "items": { "$ref": "#/$defs/sha256" } },
          "validated": { "const": true }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
