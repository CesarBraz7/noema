{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "sourceId", "blocks"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "sourceId": { "type": "string", "minLength": 1 },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "source-content.schema.json#/properties/blocks/items" },
          {
            "required": ["startMs", "endMs"],
            "properties": { "kind": { "const": "transcript_segment" } }
          }
        ]
      }
    }
  }
}
